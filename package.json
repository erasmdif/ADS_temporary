{
  "name": "ads-scms-astro",
  "version": "6.2.0",
  "description": "s:CMS - Static site Content Management System by LAD @Sapienza",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "add-collection": "node scripts/ads-cli.mjs add-collection",
    "add-content": "node scripts/ads-cli.mjs add-content",
    "images": "node scripts/ads-cli.mjs optimize-images",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:upstream": "node scripts/verify-upstream.mjs"
  },
  "keywords": [
    "astro",
    "astro-starter",
    "static-site",
    "cms",
    "content-management"
  ],
  "author": "Julian Bogdani <julian.bogdani@uniroma1.it>",
  "license": "BSD-0-Clause",
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.4",
    "@lad-sapienza/scms-core": "^0.1.0-alpha.12",
    "astro": "^7.2.4",
    "bootstrap": "^5.3.8",
    "maplibre-gl": "^6.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-slug": "^6.0.0",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "rc-slider": "^11.1.9",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "styled-components": "^6.1.19",
    "dompurify": "^3.3.0",
    "bootstrap-icons": "^1.13.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "sass": "^1.98.0",
