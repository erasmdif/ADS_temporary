---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => base + path;
---
<footer class="home-footer">
  <div class="home-inner home-footer-main">
    <div><a class="home-footer-brand" href={url('/')}>ADS</a><p>Fonti e storiografia della Sabina</p></div>
    <nav aria-label="Collegamenti del footer"><a href="#il-progetto">Il progetto</a><a href={url('/crediti/')}>Crediti</a><a href="mailto:julian.bogdani@uniroma1.it">Contatti</a></nav>
    <p class="home-footer-note">Un punto di accesso a documenti, studi e luoghi.</p>
  </div>
  <div class="home-inner home-footer-credits">
    <a href="https://www.uniroma1.it" target="_blank" rel="noreferrer"><img src={url('/images/logo_sapienza_footer.png')} width="120" alt="Sapienza Università di Roma" loading="lazy" /></a>
    <p>Realizzato con <a href="https://github.com/lad-sapienza/sCMS">sCMS</a>, sviluppato dal <a href="https://lad.saras.uniroma1.it">LAD — Sapienza</a> · <a href="mailto:julian.bogdani@uniroma1.it">Julian Bogdani</a> · <a href="mailto:erasmo.difonso@libero.it">Erasmo di Fonso</a></p>
